                CC  = gcc                                  
            CFLAGS  = -Wall -O3 -funroll-loops -fomit-frame-pointer -pipe
            CFLAGS += -I/usr/X11R6/include -I/usr/X11/include
            CFLAGS += -I/usr/local/include                 
            CFLAGS += -L/usr/X11R6/lib -L/usr/X11/lib -lX11 -lXext -lm
            CFLAGS += -L/usr/local/lib -lxstep

      APPLICATIONS  = helloworld-10 \
                      helloworld-11 \
                      helloworld-12 \
                      helloworld-13 \
                      helloworld-14 \
                      helloworld-15 \
                      helloworld-16 \
                      helloworld-17 \
                      helloworld-18 \
                      helloworld-19 \
                      helloworld-20 \
                      helloworld-21 \
                      helloworld-22 \
                      helloworld-23 \
                      helloworld-24 

